# ============================================================
# 融合教育教案生成 Agent · 环境变量样例
# 用法：cp .env.example .env  →  把占位换成真实值
# ⚠ 真实 .env 已被 .gitignore 排除，绝不要把真 key 提交入库
# ============================================================

# 【必填】主用模型：智谱 AI（glm-4-flash / glm-4.5-flash 均为免费档）
# 申请：https://open.bigmodel.cn/  →  key 形态：32位id.16位secret（共 49 字符）
ZHIPU_API_KEY=your-zhipu-key-id.your-zhipu-key-secret

# 【可选】备用模型提供方（不配则自动跳过，不影响主流程）
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
MODELSCOPE_API_KEY=

# 【可选】覆盖默认探测行为（一般不需要动）
# LPA_PROVIDER=zhipu        # 强制指定 provider：zhipu / zhipu45 / deepseek / siliconflow / modelscope / ollama / mock
# LPA_MODEL=glm-4-flash     # 覆盖模型名
# LPA_THINKING=0            # 1 = 打开思考模式（默认关）
